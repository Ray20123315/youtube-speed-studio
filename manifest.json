{
  "manifest_version": 3,
  "name": "youtube-speed-studio",
  "version": "1.0.4",
  "description": "YouTube / bilibili 播放控制、智慧 Profile、Download Studio、本機 MP4 合併、多語言、自製 UI、主題與官方更新提醒。",
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "alarms"
  ],
  "action": {
    "default_title": "youtube-speed-studio",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "page-context.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.bilibili.com/*"
      ],
      "js": [
        "runtime-bootstrap.js",
        "runtime-recovery.js",
        "providers.js",
        "content.js"
      ],
      "css": [
        "content.css",
        "accent-theme.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.youtube.com/*",
    "https://www.bilibili.com/*",
    "https://*.bilibili.com/*",
    "https://*.googlevideo.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
